# Copy to ~/.quantforge/credentials.env and run: chmod 600 ~/.quantforge/credentials.env
# Environment variables with the same names take precedence over this file.

# Twelve Data (primary market data) — https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=

# Optional: model key for the AI Judge's LLM review (only read when agents.llm.enabled = true)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# QF_LLM_API_KEY=            # for agents.llm.provider = openai-compatible

# Optional: encrypt database backups (AES-256-GCM, key derived with scrypt)
# QF_BACKUP_PASSPHRASE=
